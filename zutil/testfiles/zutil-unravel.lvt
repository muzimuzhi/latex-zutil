\input{zutil-regression-test}
\documentclass{minimal}

\usepackage[presets=none]{zutil}

\ExplSyntaxOn

\zutil_load_module:n { unravel }

\debug_on:n { all }
\debug_off:n { log-functions }

\START

\TEST{unravel}{
  \beginunravel\def\x{x}\endunravel
  \SEPARATOR
  \beginunravel[machine]\def\x{x}\endunravel
}

\TEST{unravel~short~options}{
  \beginunravel[machine, number-steps, u\edef]
  \def\x{x}\relax\edef\y{y}
  \endunravel
}

\END
