* text=auto

# overwrite language detection and stats on GitHub
# https://github.com/github-linguist/linguist/blob/main/docs/overrides.md
*.def linguist-language=tex
*.cfg linguist-language=tex

# l3build test files and outputs
*.lvt linguist-language=tex
*.pvt linguist-language=tex
*.tlg linguist-generated
*.tpf linguist-generated

# tabularray
tabularray/doc/** linguist-documentation
tabularray/**/*.html linguist-generated
*.4ht linguist-generated
